[core]
    editor = nvim
    pager = delta
    autocrlf = {{ if eq .chezmoi.os "windows" }}true{{ else }}false{{ end }}
    safecrlf = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    light = false
    true-color = always
    side-by-side = true
    pager = less -X

[merge]
    conflictStyle = zdiff3

[diff]
    colorMoved = true

[color]
    diff = yes
    status = yes
    branch = yes
    interactive = yes
    grep = yes
    hist = yes

[status]
    showuntrackedfiles = no

[push]
    default = current

[alias]
    co = checkout
    ci = commit
    st = status
    br = branch
    hist = log --pretty=format:\"%Cred%h %C(yellow)%cd%Creset %s%Cred%d %Cblue(%an)\"
    histf = log --follow --pretty=format:\"%Cred%h %C(yellow)%cd%Creset %s%Cred%d %Cblue(%an)\"
    lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    type = cat-file -t
    dump = cat-file -p
    ss = show --stat
    s = show
    f = fetch
    g = grep

[user]
    email = jukka.nousiainen@gmail.com
    name = Jukka Nousiainen

[credential]
    helper = {{ if eq .chezmoi.os "windows" }}manager{{ else }}store{{ end }}

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[rebase]
    autosquash = true

[pull]
    ff = only
